# ------------------------------------------------------------------
# Example environment configuration for the STH-SepNet course project.
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.
# Every variable here is a placeholder; the default empty/off values let
# the repository run without secrets.
# ------------------------------------------------------------------

# Root paths (relative to the repository root unless absolute).
# Point these at wherever you keep the raw datasets and downloaded
# pre-trained LLM weights on your machine (kept OUT of Git).
DATA_ROOT=./data
HF_MODELS_ROOT=./huggingface

# Optional: enable DeepSpeed (0 = off, the default; 1 = on).
STHS_USE_DS=0

# Optional API keys / tokens -- DO NOT PUT REAL VALUES HERE.
# These are only referenced by evaluation/report scripts if you enable
# external calls (e.g. wandb). Leave empty if unused.
WANDB_API_KEY=
WANDB_ENTITY=
HF_TOKEN=

# Optional: override the model download source mirror (empty = default HF hub).
HF_ENDPOINT=

# Machine label written into experiment registry rows (free text).
MACHINE_LABEL=local
